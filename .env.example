# ============================================================
# LMS Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Django Backend
# ------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-long-random-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,backend

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:8080

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite (default for dev without --profile postgres)
DATABASE_URL=

# PostgreSQL service settings (used when --profile postgres)
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password

# ------------------------------------------------------------
# Cache (Redis - optional)
# ------------------------------------------------------------
# Leave empty to use LocMemCache (default)
REDIS_URL=

# ------------------------------------------------------------
# Email (SendGrid/SMTP - optional)
# ------------------------------------------------------------
# Leave empty to use console backend (default)
SMTP_API_KEY=
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
DEFAULT_FROM_EMAIL=noreply@yourlms.com

# ------------------------------------------------------------
# Storage (AWS S3 - optional)
# ------------------------------------------------------------
# Leave empty to use local filesystem (default)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# ------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
