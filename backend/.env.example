# Django Backend Configuration
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,backend

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:8080

# Database Configuration (PostgreSQL - used when --profile postgres)
# DATABASE_URL=postgres://lms_user:lms_password@postgres:5432/lms_db

# PostgreSQL service settings (used by docker-compose)
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Configuration (Console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lms.local

# Media/Static Files
MEDIA_URL=/media/
STATIC_URL=/static/

# AWS S3 Configuration (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Redis Cache (optional)
REDIS_URL=

# Logging
LOG_LEVEL=INFO
